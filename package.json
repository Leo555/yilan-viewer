{
  "name": "yilan",
  "private": true,
  "version": "0.2.0",
  "description": "一览：纯前端在线预览 PDF、EPUB、Office、代码、文本与媒体文件，文件只在本机浏览器中处理",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "PORT=${PORT:-4174} node scripts/serve.mjs",
    "vendor": "node scripts/vendor.mjs",
    "examples": "node scripts/examples.mjs",
    "examples:docs": "node scripts/make-doc-examples.mjs && node scripts/examples.mjs",
    "examples:media": "swift scripts/make-media-examples.swift && node scripts/examples.mjs"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "dompurify": "3.4.18",
    "epubjs": "0.3.93",
    "jszip": "3.10.1",
    "mammoth": "1.13.0",
    "marked": "18.2.1",
    "pdfjs-dist": "6.5.438",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
